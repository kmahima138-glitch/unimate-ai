# UniMate AI Environment Configuration
# Copy this file to .env and customize as needed.

# Application Settings
APP_NAME=UniMate AI
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# LLM Configuration
# Provide your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# If not provided, UniMate AI will run in intelligent offline grounded-rule mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Database Paths
DATA_DIR=data
DB_URL=sqlite:///data/unimate.db
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chromadb

# Document Processing & RAG Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35
